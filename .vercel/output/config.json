{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/admin/?(?:/__data.json)?$",
			"dest": "/admin"
		},
		{
			"src": "^/api/categories/?(?:/__data.json)?$",
			"dest": "/api/categories"
		},
		{
			"src": "^/api/categories/slug/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/categories/slug/[slug]"
		},
		{
			"src": "^/api/categories/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/categories/[id]"
		},
		{
			"src": "^/api/criteria/?(?:/__data.json)?$",
			"dest": "/api/criteria"
		},
		{
			"src": "^/api/criteria/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/criteria/[id]"
		},
		{
			"src": "^/api/items/?(?:/__data.json)?$",
			"dest": "/api/items"
		},
		{
			"src": "^/api/items/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/items/[id]"
		},
		{
			"src": "^/api/leaderboard/?(?:/__data.json)?$",
			"dest": "/api/leaderboard"
		},
		{
			"src": "^/api/ratings/?(?:/__data.json)?$",
			"dest": "/api/ratings"
		},
		{
			"src": "^/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/[categorySlug]"
		},
		{
			"src": "^/([^/]+?)/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/[categorySlug]/[itemId]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}